All manifests should match snapshot:
  1: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      labels:
        app.kubernetes.io/instance: simple
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: simple-job
        app.kubernetes.io/version: 1.1.1
        helm.sh/chart: simple-job-0.0.0
      name: simple-simple-job
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: simple
            app.kubernetes.io/name: simple-job
        spec:
          containers:
            - env:
                - name: TEST
                  value: test
              image: test:1.1.1
              imagePullPolicy: IfNotPresent
              name: simple-job
              resources: {}
              securityContext: {}
              volumeMounts:
                - mountPath: /data
                  name: data
          restartPolicy: Never
          securityContext: {}
          serviceAccountName: simple-simple-job
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: simple-simple-job-data
  2: |
    apiVersion: v1
    kind: PersistentVolumeClaim
    metadata:
      labels:
        app.kubernetes.io/instance: simple
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: simple-job
        app.kubernetes.io/version: 1.1.1
        helm.sh/chart: simple-job-0.0.0
      name: simple-simple-job-data
    spec:
      accessModes:
        - ReadWriteOnce
      resources:
        requests:
          storage: 1Gi
  3: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/instance: simple
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: simple-job
        app.kubernetes.io/version: 1.1.1
        helm.sh/chart: simple-job-0.0.0
      name: simple-simple-job
